# ─────────────────────────────────────────────────────────────────────────────
#  Internship Studio — Synthetic Monitoring
#  Copy to .env and fill in.  Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Targets ──────────────────────────────────────────────────────────────────
# Student dashboard (React app + PHP API on server.accofin.in)
DASHBOARD_URL=https://dashboard.internshipstudio.com
# Exam frontend (the page a student actually sits the exam on)
EXAM_URL=https://exam.internshipstudio.com
# Exam API (Node/Express, port 3001 on the payment-app box)
EXAM_API_URL=https://examapi.internshipstudio.com
# Payment API (Go/chi, port 3002 on the payment-app box)
PAYMENT_API_URL=https://paymentapi.internshipstudio.com
# Public marketing site (optional, blank = skip)
WEBSITE_URL=https://internshipstudio.com

# ── Schedules (cron, server local time) ──────────────────────────────────────
# Light checks: availability + API health. Cheap, run often.
CRON_LIGHT=*/5 * * * *
# Full student journey: register -> exam -> submit -> checkout. Creates one
# synthetic user per run, so keep it slower than the light checks.
CRON_JOURNEY=*/15 * * * *
# Run everything immediately on boot instead of waiting for the first tick.
RUN_ON_BOOT=true

# ── The test account ─────────────────────────────────────────────────────────
# ONE fixed account is used for every journey run. Before each run the monitor
# deletes it from the database and registers it again from scratch, so
# registration is genuinely re-tested every time and the account never carries
# state (an already-taken exam, an existing paid order) from the last run.
#
# The email must satisfy the register form's own validation:
#   /^\w+([.-]?\w+)*@\w+([.-]?\w+)*(\.\w{2,3})+$/
# Letters, digits, underscore, dot and hyphen only — NO "+" addressing.
MONITOR_EMAIL=monitor.test@internshipstudio.com
MONITOR_PASSWORD=M0nitorTest2026
# Letters only — register2.php rejects digits and symbols in names.
MONITOR_FIRST_NAME=Monitor
MONITOR_LAST_NAME=Testaccount
# Exactly 10 digits, must start with 6-9.
#
# It must be a number NO real student has registered. The reset deletes the
# test account by email; the phone is a separate unique key, so if it belongs
# to somebody else's account that row is never freed and registration fails
# forever with "Mobile number already exists". Check first:
#   SELECT id, email FROM users WHERE phone = '<your-number>';
# (The registration check verifies this and names the conflicting account.)
MONITOR_PHONE=9000000004
MONITOR_COUNTRY_CODE=91

# ── Database access (required for the delete-and-recreate cycle) ─────────────
# The monitor deletes the test account before re-registering it. Scope this
# MySQL user as tightly as you can: DELETE + UPDATE on the tables in
# DB_CLEANUP_TABLES and on `users`, and nothing else.
DB_CLEANUP_ENABLED=true
DB_HOST=15.207.59.247
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=istudio_cit

# Log what WOULD be deleted without deleting it. Leave this on for the first
# few runs and read the output before switching it off.
DB_CLEANUP_DRY_RUN=true

# Extra child tables to clear, as table:user_id_column, comma separated.
#
# Normally leave this EMPTY. Every table with a declared foreign key to `users`
# is discovered from the schema automatically — there are 76 in istudio_cit,
# and MySQL refuses to delete the user row while any of them still holds a
# reference, so the list has to come from the database rather than from here.
#
# Only add a table if it references users WITHOUT a foreign key constraint, so
# discovery cannot see it. The error message names the table when that happens.
DB_CLEANUP_TABLES=

# After registering, set users.is_test_account = 1 on the row so reporting can
# exclude it. Set to false if your schema has no such column.
DB_MARK_TEST_ACCOUNT=true

# Primary key column on `users`. Leave blank to detect it automatically
# (tries user_id, then id). This schema uses user_id.
DB_USERS_ID_COLUMN=

# ── Monitoring history (for the admin panel) ─────────────────────────────────
# Writes one row per check per run so your admin panel can show history,
# uptime and past incidents.
#
# This uses a SEPARATE database on purpose. The monitoring user needs INSERT
# and DELETE to maintain the history table; granting that on istudio_cit would
# let it write into tables holding real student data. Keeping history in its
# own database means its only writes against istudio_cit stay the DELETE and
# UPDATE on its own test account.
#
# Setup, once:
#   1. cPanel > Manage My Databases > Create New Database: monitor
#   2. Add User To Database: monitoring -> monitor, ALL PRIVILEGES
#   3. phpMyAdmin > monitor > SQL > run deploy/monitoring-report-table.sql
#   4. Set DB_REPORT_ENABLED=true below
DB_REPORT_ENABLED=false
DB_REPORT_NAME=monitor
DB_REPORT_TABLE=monitoring_runs
# Rows older than this are pruned automatically. ~600 rows/day at the default
# schedules, so 90 days settles at roughly 55,000 rows.
DB_REPORT_RETENTION_DAYS=90
# Blank = reuse DB_HOST / DB_PORT / DB_USER / DB_PASSWORD from above.
DB_REPORT_HOST=
DB_REPORT_PORT=
DB_REPORT_USER=
DB_REPORT_PASSWORD=

# ── Exam ─────────────────────────────────────────────────────────────────────
# 15 = mock exam, 1 = the live iCAT. Keep this on the mock exam.
MONITOR_EXAM_ID=15
# How many questions the synthetic student answers before submitting.
MONITOR_EXAM_ANSWERS=3

# ── Payment ──────────────────────────────────────────────────────────────────
# Default: the check creates a real order, confirms the gateway checkout
# renders, then ABANDONS it. Nothing is charged.
#
# PAYMENT_COMPLETE=true drives the card form and pays for real.
#
# ⚠ READ THIS BEFORE ENABLING IT IN PRODUCTION
#   Indian card payments require additional-factor authentication (RBI rules):
#   the bank sends a one-time OTP to the cardholder's phone. That OTP cannot be
#   read by an automated browser, so a REAL ₹1 card payment cannot be completed
#   unattended. The same applies to UPI (approval in the payer's app) and
#   netbanking (bank login).
#
#   Where automated completion DOES work:
#     • Gateway sandbox/test mode. Cashfree TEST and Razorpay test keys accept
#       published test cards with a fixed OTP, and the whole chain runs
#       unattended: checkout → payment → webhook → order → access activation.
#       Point PAYMENT_API_URL at a staging payment-backend running with
#       CASHFREE_ENVIRONMENT=TEST, then set PAYMENT_COMPLETE=true.
#     • A gateway account configured for zero-AFA / saved-card recurring
#       mandates, if you have one. Most accounts do not.
#
#   With PAYMENT_COMPLETE=false (the default) the check still catches the
#   failure the spec cares about — "payment gateway did not load" — plus a
#   broken order API and unreachable webhooks.
PAYMENT_COMPLETE=false
PAYMENT_TEST_AMOUNT=1.00
PAYMENT_INTERNSHIP_NAME=Monitoring Synthetic Check
PAYMENT_RETURN_URL=https://dashboard.internshipstudio.com/payment-status?source=monitoring
# Use /create-order-testing instead of /create-order (recommended: it is the
# endpoint payment-backend already has for exactly this).
PAYMENT_USE_TESTING_ENDPOINT=true

# Card used when PAYMENT_COMPLETE=true. Sandbox test card values by default —
# these are published test numbers, not real cards.
PAYMENT_CARD_NUMBER=4111111111111111
PAYMENT_CARD_EXPIRY_MONTH=12
PAYMENT_CARD_EXPIRY_YEAR=30
PAYMENT_CARD_CVV=123
PAYMENT_CARD_HOLDER=Monitor Testaccount
# Fixed OTP the sandbox accepts. Leave blank in production — there is no fixed
# OTP there, which is exactly why production cannot be automated.
PAYMENT_CARD_OTP=123456
# How long to wait for the return_url redirect after paying.
PAYMENT_CONFIRM_TIMEOUT_MS=120000

# ── Alerting ─────────────────────────────────────────────────────────────────
ALERT_ENABLED=true
# Comma-separated recipients.
ALERT_TO=dev1@internshipstudio.com,dev2@internshipstudio.com
ALERT_FROM=monitoring@internshipstudio.com
ALERT_SUBJECT_PREFIX=[iStudio Monitor]

SMTP_HOST=mailhost.internshipstudio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@internshipstudio.com
SMTP_PASSWORD=

# Optional Slack incoming webhook (blank = disabled)
SLACK_WEBHOOK_URL=
# Optional generic webhook, receives the full JSON result (blank = disabled)
GENERIC_WEBHOOK_URL=

# ── Alert throttling ─────────────────────────────────────────────────────────
# A check must fail this many consecutive runs before the first alert fires.
# Guards against one-off blips. 1 = alert immediately.
ALERT_AFTER_CONSECUTIVE_FAILURES=1

# Send an email on EVERY failing run, not once plus an hourly reminder.
# Noisier by design: it gives a second channel (Slack, WhatsApp) a signal on
# every run to escalate on. With this off, you get one email then one reminder
# per ALERT_REPEAT_MINUTES.
ALERT_ON_EVERY_FAILURE=true
# While a check stays broken, re-send a reminder every N minutes.
ALERT_REPEAT_MINUTES=60
# Send a "RECOVERED" email when a failing check goes green again.
ALERT_ON_RECOVERY=true

# ── Runtime ──────────────────────────────────────────────────────────────────
HEADLESS=true
# Per-step Playwright timeout.
STEP_TIMEOUT_MS=30000
# Whole-check ceiling.
CHECK_TIMEOUT_MS=180000
# Retries before a check is declared failed (per the spec: retry, then alert).
CHECK_RETRIES=1
# Screenshots/HTML/console logs land here.
ARTIFACT_DIR=./artifacts
# Delete artifacts older than this.
ARTIFACT_RETENTION_DAYS=7
LOG_LEVEL=info

# ── Status dashboard (optional, tiny express app) ────────────────────────────
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080
# Leave blank to allow any IP that reaches the port (put it behind nginx/SG).
DASHBOARD_TOKEN=

# ── Escalation ladder ────────────────────────────────────────────────────────
# Which channel each successive notification uses during ONE continuous outage.
# The list cycles, so a long outage keeps changing medium instead of sending
# the same email over and over — which is what actually gets noticed.
#
#   failure 1 -> email
#   failure 2 -> slack
#   failure 3 -> slack-urgent   (@channel — pushes to everyone's phone)
#   failure 4 -> email again (the list wraps)
#
# A recovery notifies EVERY channel, so nobody is left thinking it is broken.
# Valid values: email, slack, slack-urgent
ALERT_ESCALATION=email,slack,slack-urgent

# ── Slack ────────────────────────────────────────────────────────────────────
# STRONGLY PREFERRED: a bot token from your own Slack app. It never expires.
#   api.slack.com/apps > Create New App > From scratch
#   OAuth & Permissions > Bot Token Scopes: chat:write, chat:write.public
#   Install to Workspace > copy the "Bot User OAuth Token" (starts xoxb-)
#   Then invite it:  /invite @YourAppName   in the target channel
SLACK_BOT_TOKEN=

# Channel to post in.
#
# USE THE CHANNEL ID, not the name. In a .env file "#" starts a comment, so
#   SLACK_CHANNEL=#alerts
# parses as an EMPTY value and Slack alerts silently do not send. A channel ID
# has no "#" and cannot be mangled.
#
# Find it: click the channel > View channel details > scroll to the bottom.
# If you must use the name, quote it:  SLACK_CHANNEL="#alerts"
SLACK_CHANNEL=C01ABCDEFGH

# Only needed if you use a ROTATING user token (xoxe.xoxp-…) instead of a bot
# token. Those expire every ~12 hours and cannot be refreshed without the app's
# client id and secret, so all four fields are required together.
SLACK_TOKEN=
SLACK_REFRESH_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# NOTE ON "SLACK CALLS"
# Slack has no API that rings a person. calls.add only registers an external
# call (Zoom/Meet) as an object; Huddles cannot be started programmatically.
# The loudest Slack itself can be is the @channel mention that slack-urgent
# sends, which pushes a notification to every member's phone.
# For a REAL phone call, add Twilio Voice as a channel — ask and it can be built.
