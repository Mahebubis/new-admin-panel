<?php
/**
 * secret.php — the HMAC key that signs "Go to learning portal" handoff links.
 *
 * The SAME string must exist in BOTH places:
 *   • training_dashboard/public/api/config/secret.php   (verifies the link)
 *   • user_dashboard    /public/api/config/secret.php   (mints the link)
 *
 * Without it the portal rejects every handoff, because a bare row id would
 * otherwise let anyone type ?sso=1234 and land inside someone else's account.
 *
 * Generate one with:  php -r "echo bin2hex(random_bytes(32));"
 * Copy this file to secret.php on both servers. Never commit secret.php.
 */
return 'CHANGE-ME-64-hex-characters-shared-by-both-apps';
