# Same-origin in dev too: vite.config.js proxies /api to the live host, which
# keeps the PHP session cookie first-party. Point this at a full URL only if you
# deliberately want to bypass the proxy — and expect 401s if you do.
VITE_API_BASE=/api

# The Google Identity client id. Must match public/api/config/google.php.
VITE_GOOGLE_CLIENT_ID=
